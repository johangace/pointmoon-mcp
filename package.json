{
  "name": "pointmoon-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.johangace/pointmoon",
  "description": "MCP stdio server for Pointmoon — sourced, current physical and environmental field-truth for a geographic coordinate. Each fact carries source, observedAt, ttlMinutes, and confidence, or explicit typed silence. Never guesses.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "pointmoon-mcp": "./bin/pointmoon-mcp.mjs"
  },
  "scripts": {
    "examples": "node examples/run-all.mjs",
    "examples:drill": "node examples/ci-failure-drill.mjs",
    "conformance": "node conformance/run.mjs",
    "conformance:drill": "node conformance/drill.mjs",
    "registry:preflight": "node scripts/registry-preflight.mjs"
  },
  "files": [
    "bin/",
    "CONTRACT.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pointmoon",
    "field-truth",
    "ground-truth",
    "weather",
    "environment",
    "geospatial",
    "provenance",
    "grounding",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johangace/pointmoon-mcp.git"
  },
  "homepage": "https://github.com/johangace/pointmoon-mcp#readme",
  "bugs": "https://github.com/johangace/pointmoon-mcp/issues"
}
